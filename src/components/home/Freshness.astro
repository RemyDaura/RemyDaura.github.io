---
/**
 * 02 · Fraîcheur : le relevé du jour publié par le pipeline du dossier n°14.
 * Rendu au build avec l'instantané ; le navigateur gère le choix du carburant
 * et remplace les valeurs par le relevé du matin (src/scripts/releve-client.ts).
 */
import Section from '../trace/Section.astro';
import Link from '../ui/Link.astro';
import { PIPELINE } from '../../data/site';
import { HOME } from '../../i18n/home';
import { useTranslations, type Lang } from '../../i18n/ui';
import { dossierPath } from '../../lib/dossiers';
import { FUEL_CODES, SNAPSHOT, computeStatus } from '../../lib/releve';
import { widgetView } from '../../lib/releve-view';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { freshness } = HOME[lang];
const view = widgetView(SNAPSHOT, computeStatus(SNAPSHOT, null, new Date()), lang, 'gazole');
// La date du relevé est dans la barre d'état, mise à jour en direct : pas ici, où elle resterait figée.
const aside = 'mart_prix_jour_departement';
---

<Section id="fraicheur" label={freshness.label} title={freshness.title} intro={freshness.intro} aside={aside}>
  <div class="releve panel" data-releve data-state={view.state}>
    <div class="releve-head">
      <span class="state" data-state={view.state}
        ><span class="state-mark" aria-hidden="true"></span><span data-field="chip">{view.chip}</span></span
      >
      <span data-field="loaded">{view.loaded}</span>
      <span data-field="tests">{view.tests}</span>
    </div>

    <div class="releve-body">
      <div class="fuels" role="group" aria-label={t.releve.fuelGroup}>
        {
          FUEL_CODES.map((code) => (
            <button type="button" class="fuel" data-fuel={code} aria-pressed={code === 'gazole' ? 'true' : 'false'}>
              {t.releve.fuels[code]}
            </button>
          ))
        }
      </div>

      <div class="values" aria-live="polite">
        <div class="value">
          <span class="value-label">{t.releve.france}</span>
          <span class="value-number" data-field="france">{view.france}</span>
          <span class="value-sub" data-field="per-litre">{view.perLitre}</span>
        </div>
        <div class="value value-dept">
          <span class="value-label">{t.releve.department}</span>
          <span class="value-number accent" data-field="department">{view.department}</span>
          <span class="value-sub trend" data-trend={view.trend} data-field="comparison">{view.comparison}</span>
        </div>
      </div>

      <p class="releve-note" data-field="note" hidden={view.note === ''}>{view.note}</p>

      <figure class="history" data-history hidden>
        <figcaption class="history-head">
          <span class="history-title" data-field="history-title"></span>
          <span class="history-legend">
            <span class="legend-item"><span class="line-key series-france" aria-hidden="true"></span>{t.releve.france}</span>
            <span class="legend-item"
              ><span class="line-key series-department" aria-hidden="true"></span>{t.releve.historyDepartment}</span
            >
          </span>
        </figcaption>
        <div class="history-plot" data-history-plot role="img" tabindex="0" aria-label="">
          <div class="history-tooltip" data-history-tooltip hidden></div>
        </div>
        <details class="history-data">
          <summary>{t.releve.historyTable}</summary>
          <div class="table-scroll" role="region" tabindex="0" aria-label={t.releve.historyTableLabel}>
            <table class="data-table">
              <thead>
                <tr>
                  <th scope="col">{t.releve.historyDay}</th>
                  <th scope="col">{t.releve.france}</th>
                  <th scope="col">{t.releve.historyDepartment}</th>
                </tr>
              </thead>
              <tbody data-history-rows></tbody>
            </table>
          </div>
        </details>
      </figure>
    </div>

    <div class="releve-foot">
      <p class="method">{t.releve.method}</p>
      <span class="foot-links">
        <Link href={PIPELINE.repo} data-field="run-link" hidden>{t.releve.runLink}</Link>
        <a href={`${dossierPath(lang, 14)}#lignage`}>{t.releve.howBuilt}</a>
      </span>
    </div>
  </div>
</Section>

<script>
  import { initWidget } from '../../scripts/releve-client';

  const root = document.querySelector<HTMLElement>('[data-releve]');
  if (root) initWidget(root);
</script>

<style>
  .releve-head,
  .releve-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    align-items: center;
    padding: 14px 20px;
  }

  .releve-head {
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-2);
  }

  .releve-foot {
    justify-content: space-between;
    border-top: 1px solid var(--line);
  }

  .releve-body {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 20px;
  }

  .fuels {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .fuel {
    min-width: 72px;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .fuel:hover {
    border-color: var(--accent);
  }

  .fuel[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }

  .values {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    border-top: 1px solid var(--line);
  }

  .value {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 24px 4px 0;
  }

  .value-dept {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .value-label,
  .value-sub {
    font-size: 14px;
    color: var(--text-3);
  }

  .value-number {
    font-family: var(--font-mono);
    font-size: clamp(38px, 5vw, 48px);
    font-weight: 500;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .accent {
    color: var(--accent);
  }

  .trend[data-trend='cheaper'] {
    color: var(--ok);
  }

  .trend[data-trend='dearer'] {
    color: var(--warm);
  }

  /* Valeurs grisées quand le relevé n'est pas celui du jour */
  [data-releve]:not([data-state='ok']) .value-number {
    color: var(--text-2);
  }

  [data-releve][data-state='late'] {
    border-color: var(--late-line);
  }

  [data-releve][data-state='failed'] {
    border-color: var(--fail-line);
  }

  .releve-note {
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-3);
  }

  [data-releve][data-state='late'] .releve-note {
    color: var(--late);
  }

  [data-releve][data-state='failed'] .releve-note {
    color: var(--fail);
  }

  /* Courbe des 30 derniers jours */
  .history {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .history[hidden] {
    display: none;
  }

  .history-head {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    align-items: baseline;
    justify-content: space-between;
  }

  .history-title {
    font-size: 15px;
    font-weight: 600;
  }

  .history-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    font-size: 13px;
    color: var(--text-2);
  }

  .legend-item {
    display: inline-flex;
    gap: 8px;
    align-items: center;
  }

  /* Global : les clés de l'infobulle sont créées par le script */
  .history :global(.line-key) {
    display: inline-block;
    flex: none;
    width: 16px;
    height: 2px;
    border-radius: 1px;
    background: var(--series-france);
  }

  .history :global(.line-key.series-department) {
    background: var(--series-department);
  }

  .history-plot {
    position: relative;
    min-height: 200px;
    border-radius: 2px;
    touch-action: pan-y;
  }

  .history-plot:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .history-plot :global(svg) {
    display: block;
    overflow: visible;
  }

  .history-plot :global(.chart-grid line) {
    stroke: var(--line-soft);
    stroke-width: 1;
  }

  .history-plot :global(.chart-grid text),
  .history-plot :global(.chart-axis text) {
    fill: var(--text-3);
    font-family: var(--font-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .history-plot :global(.chart-line) {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .history-plot :global(.chart-line.series-france) {
    stroke: var(--series-france);
  }

  .history-plot :global(.chart-line.series-department) {
    stroke: var(--series-department);
  }

  .history-plot :global(.chart-dot) {
    stroke: var(--panel);
    stroke-width: 2;
  }

  .history-plot :global(.chart-dot.series-france) {
    fill: var(--series-france);
  }

  .history-plot :global(.chart-dot.series-department) {
    fill: var(--series-department);
  }

  .history-plot :global(.chart-crosshair) {
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .history-tooltip {
    position: absolute;
    top: 4px;
    z-index: 1;
    min-width: 180px;
    padding: 10px 12px;
    border: 1px solid var(--line-strong);
    background: var(--bg-deep);
    font-size: 13px;
    pointer-events: none;
  }

  .history-tooltip :global(.tip-date) {
    margin-bottom: 6px;
    color: var(--text-3);
  }

  .history-tooltip :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .history-tooltip :global(li) {
    display: flex;
    gap: 8px;
    align-items: center;
    color: var(--text-2);
  }

  .history-tooltip :global(strong) {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--text);
  }

  .history-data summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }

  .history-data table {
    margin-top: 4px;
    font-size: 14px;
  }

  .history-data td {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .method {
    max-width: 760px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-3);
  }

  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 14px;
    font-weight: 500;
  }

  @media (max-width: 600px) {
    .value-dept {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
