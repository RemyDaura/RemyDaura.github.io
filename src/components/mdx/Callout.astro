---
/**
 * Encadré avec un intitulé : <Callout title="Trois questions à résoudre"> liste </Callout>
 */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="callout" role="note">
  <p class="callout-title">{title}</p>
  <div class="callout-body">
    <slot />
  </div>
</div>

<style>
  .callout {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px;
    border: 1px solid var(--line);
    background: var(--panel);
  }

  .callout-title {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .callout-body :global(ol),
  .callout-body :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding-left: 20px;
    font-size: 16px;
    line-height: 1.5;
  }

  .callout-body :global(li::marker) {
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .callout-body :global(p) {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-2);
  }
</style>
