---
/**
 * Tableau Markdown (syntaxe | a | b |) : défilement horizontal sur petit écran,
 * première colonne en gras. La zone défilante est atteignable au clavier.
 */
import { DEFAULT_LANG, isLang, useTranslations } from '../../i18n/ui';

const t = useTranslations(isLang(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LANG);
---

<div class="table-scroll" role="region" aria-label={t.table} tabindex="0">
  <table class="data-table prose-table">
    <slot />
  </table>
</div>

<style>
  .prose-table :global(th) {
    padding: 12px 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-align: left;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .prose-table :global(thead tr) {
    background: var(--panel);
  }

  .prose-table :global(tbody tr) {
    border-top: 1px solid var(--line);
    vertical-align: top;
  }

  .prose-table :global(td) {
    padding: 15px 16px;
    line-height: 1.55;
    color: var(--text-2);
  }

  .prose-table :global(td:first-child) {
    width: 36%;
    font-weight: 600;
    color: var(--text);
  }
</style>
