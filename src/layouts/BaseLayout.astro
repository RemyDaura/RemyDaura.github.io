---
/**
 * Gabarit commun : <head> (référencement, partage, langues), barre d'état, en-tête,
 * contenu, pied de page. Les polices sont auto-hébergées (aucun appel à Google Fonts).
 */
// Sous-ensembles latin et latin étendu seulement (français, anglais) : pas de cyrillique ni de grec
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-ext-400.css';
import '@fontsource/ibm-plex-sans/latin-400-italic.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-ext-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-sans/latin-ext-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import '../styles/global.css';

import sans400 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import sans600 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-600-normal.woff2?url';
import mono400 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';

import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import StatusBar from '../components/StatusBar.astro';
import { SITE } from '../data/site';
import { DEFAULT_LANG, LANGS, useTranslations, type Lang } from '../i18n/ui';
import type { NavItem } from '../lib/types';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Chemin de la page dans chaque langue (sert au sélecteur de langue et aux balises hreflang). */
  alternates: Record<Lang, string>;
  nav: { label: string; items: NavItem[] };
  /** Image de partage (chemin public). */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Phrase d'appel en pied de page. */
  cta?: string;
  /** Données structurées schema.org. */
  jsonLd?: Record<string, unknown>;
}

const { lang, title, description, alternates, nav, ogImage, ogType = 'website', cta, jsonLd } = Astro.props;
const t = useTranslations(lang);

const absolute = (path: string) => new URL(path, SITE.url).href;
const canonical = absolute(alternates[lang]);
const image = absolute(ogImage ?? `/og/accueil-${lang}.png`);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="google-site-verification" content={SITE.googleVerification} />
    <meta name="theme-color" content="#0e141b" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonical} />
    {LANGS.map((code) => <link rel="alternate" hreflang={code} href={absolute(alternates[code])} />)}
    <link rel="alternate" hreflang="x-default" href={absolute(alternates[DEFAULT_LANG])} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={sans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sans600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={mono400} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#contenu">{t.skip}</a>
    <StatusBar lang={lang} />
    <SiteHeader lang={lang} alternates={alternates} items={nav.items} navLabel={nav.label} />
    <main id="contenu" class="wrap" tabindex="-1">
      <slot />
    </main>
    <slot name="after-main" />
    <SiteFooter lang={lang} cta={cta} />
    <script>
      import '../scripts/trace';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
